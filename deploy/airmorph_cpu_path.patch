+    bounding_right = np.asarray(find_bb_3D(right), dtype=float)
+
+    objects = ndimage.find_objects(skel.astype(np.int32))
+    coords_by_label = {}
+    for label, obj in enumerate(objects, 1):
+        if obj is None:
+            continue
+        local = np.argwhere(skel[obj] == label)
+        starts = np.array([sl.start for sl in obj])
+        coords_by_label[label] = local + starts
+
+    for zero_idx in range(max_label):
+        label = zero_idx + 1
+        parents = np.where(parent_map[zero_idx] == 1)[0]
+        if not len(parents):
+            continue
+        parent_label = int(parents[0]) + 1
+        coords = coords_by_label.get(label, np.empty((0, 3), dtype=int))
+        parent_coords = coords_by_label.get(
+            parent_label, np.empty((0, 3), dtype=int))
+        if not len(coords) or not len(parent_coords):
+            continue
+        values = mask[tuple(coords.T)]
+        side[zero_idx] = 2 if np.any(values == 2) else (1 if np.any(values == 1) else 0)
+        mins, maxs = coords.min(axis=0), coords.max(axis=0) + 1
+        pmins, pmaxs = parent_coords.min(axis=0), parent_coords.max(axis=0) + 1
+        center = (mins + maxs) / 2.0

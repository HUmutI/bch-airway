+def process_iteration_cpu(
+    skel, generation, xt, yt, zt, spacing,
+    parent_map, children_map, mask, lr
+):
+    """NumPy equivalent of AirMorph's feature-extraction CUDA kernel."""
+    max_label = int(skel.max())
+    node_idx = np.full(max_label, -1, dtype=np.int32)
+    total = np.zeros((max_label, 17), dtype=np.float32)
+    side = np.zeros(max_label, dtype=np.int32)
+    spacing = np.asarray(spacing, dtype=float)
